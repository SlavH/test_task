{
  "name": "fixcall-receptionist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FixCall AI voice receptionist with a Telegram-style call inbox",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "dev": "node --watch src/main.mjs",
    "build": "esbuild web/voice-call.js --bundle --format=iife --global-name=FixCallVoice --outfile=public/voice-call.js --minify",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/main.mjs && node --check src/httpApp.mjs && node --check web/voice-call.js && node --check public/app.js",
    "provision": "node scripts/provision-retell.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "migrate": "node scripts/migrate.mjs",
    "simulate": "node scripts/simulate-call.mjs"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "retell-client-js-sdk": "^3.0.3"
  }
}
