# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
COMPANY_NAME=FixCall Appliance Repair
TIMEZONE=America/Los_Angeles

# Database
DATABASE_URL=postgres://fixcall:fixcall@localhost:5432/fixcall

# Retell
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...
RETELL_API_BASE=https://api.retellai.com

# Telegram notifications
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Admin access
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

DASHBOARD_TITLE=FixCall Inbox

# Safety and testing
ALLOW_UNSIGNED_RETELL=false
WEB_CALL_RATE_LIMIT=5
FINALIZE_ORPHANS=true
