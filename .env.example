# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data
COMPANY_NAME=FixCall Appliance Repair
TIMEZONE=America/Los_Angeles

# Database
DATABASE_URL=postgres://fixcall:fixcall@localhost:5432/fixcall
MIGRATION_DATABASE_URL=postgres://fixcall:fixcall@localhost:5432/fixcall

# Supabase integration fallbacks (optional)
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Retell
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...
RETELL_PHONE_NUMBER=+14155550100
RETELL_API_BASE=https://api.retellai.com

# Telegram notifications
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789  # single ID or comma/space-separated list for multiple recipients (or use /start subscriptions)
TELEGRAM_WEBHOOK_SECRET=  # optional secret token for POST /api/telegram/webhook

# Admin access
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

DASHBOARD_TITLE=FixCall Inbox

# Safety and testing
ALLOW_UNSIGNED_RETELL=false
WEB_CALL_RATE_LIMIT=5

# Optional rate limiting for Vercel/serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FINALIZE_ORPHANS=true
